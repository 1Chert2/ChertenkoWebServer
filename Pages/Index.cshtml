@page
@model ChertenkoWebServer.Pages.IndexModel
@{
    ViewData["Title"] = "Главная";
}

<section class="card">
    <h2>Информация о сервере</h2>
    <button type="button" class="btn" id="load-server-info">Получить данные</button>
    <div id="result"></div>
</section>

<section class="card">
    <h2>Сложение</h2>
    <div class="row">
        <label class="field">a
            <input type="text" inputmode="decimal" id="sum-a" value="8" autocomplete="off">
        </label>
        <label class="field">b
            <input type="text" inputmode="decimal" id="sum-b" value="4" autocomplete="off">
        </label>
        <button type="button" class="btn" id="calculate-sum">Вычислить</button>
    </div>
    <div id="sum-result" class="output"></div>
</section>

<section class="card">
    <h2>Деление</h2>
    <div class="row">
        <label class="field">a
            <input type="text" inputmode="decimal" id="divide-a" value="10" autocomplete="off">
        </label>
        <label class="field">b
            <input type="text" inputmode="decimal" id="divide-b" value="2" autocomplete="off">
        </label>
        <button type="button" class="btn" id="calculate-divide">Вычислить</button>
    </div>
    <div id="divide-result" class="output"></div>
</section>

<section class="card">
    <h2>Эхо</h2>
    <div class="row">
        <label class="field grow">
            <input type="text" id="echo-text" value="Привет!" autocomplete="off">
        </label>
        <button type="button" class="btn" id="send-echo">Отправить</button>
    </div>
    <div id="echo-result" class="output"></div>
</section>

<section class="card card--wide">
    <h2>Задачи</h2>
    <div class="row">
        <label class="field grow">
            <input type="text" id="new-task-title" placeholder="Новая задача" autocomplete="off">
        </label>
        <button type="button" class="btn" id="add-task">Добавить</button>
        <button type="button" class="btn btn--ghost" id="show-tasks">Обновить список</button>
    </div>
    <div class="row">
        <label class="field grow">
            <input type="text" id="search-tasks" placeholder="Поиск..." autocomplete="off">
        </label>
    </div>
    <div id="task-feedback" class="output"></div>
    <ul id="task-list" class="task-list"></ul>
    <p class="reference__note">
        Полноценный менеджер задач — на странице <a asp-page="/Tasks/Index">Задачи</a>.
    </p>
</section>

@section Scripts {
    <script type="module" src="/js/app.js"></script>
}
