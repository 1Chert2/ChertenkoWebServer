@page
@model ChertenkoWebServer.Pages.Tasks.IndexModel
@{
    ViewData["Title"] = "Задачи";
}

<section class="card card--wide">
    <h2>Задачи</h2>

    <!-- Фильтрация и сортировка -->
    <form method="get" class="row">
        <label class="field">Категория
            <select asp-for="CategoryId" asp-items="@(new SelectList(Model.Categories, "Id", "Name"))">
                <option value="">Все категории</option>
            </select>
        </label>
        <label class="field">Сортировка
            <select asp-for="SortBy">
                <option value="created">По дате создания</option>
                <option value="title">По названию</option>
            </select>
        </label>
        <label class="field grow">Поиск
            <input type="text" asp-for="Search" placeholder="Поиск по названию..." />
        </label>
        <input type="hidden" asp-for="CurrentPage" value="1" />
        <input type="hidden" asp-for="PageSize" value="@Model.PageSize" />
        <button type="submit" class="btn">Применить</button>
        <a asp-page="/Tasks/Index" class="btn btn--ghost">Сбросить</a>
    </form>

    <p class="reference__note">
        Всего задач: <strong>@Model.TotalCount</strong>, страница @Model.CurrentPage из @Model.TotalPages
    </p>

    <!-- Список задач -->
    <table class="task-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Название</th>
                <th>Категория</th>
                <th>Статус</th>
                <th>Создана</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var task in Model.Items)
            {
                <tr class="@(task.IsDone ? "task--done" : "")">
                    <td>@task.Id</td>
                    <td>@task.Title</td>
                    <td>@task.CategoryName</td>
                    <td>
                        <form method="post" asp-page-handler="Toggle">
                            <input type="hidden" name="id" value="@task.Id" />
                            <input type="hidden" name="isDone" value="@(!task.IsDone)" />
                            <button type="submit" class="btn btn--small">
                                @(task.IsDone ? "↩ Вернуть" : "✔ Выполнено")
                            </button>
                        </form>
                    </td>
                    <td>@task.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                    <td class="row">
                        <a asp-page="/Tasks/Edit" asp-route-id="@task.Id" class="btn btn--small">Изменить</a>
                        <form method="post" asp-page-handler="Delete" onsubmit="return confirm('Удалить задачу #@task.Id?');">
                            <input type="hidden" name="id" value="@task.Id" />
                            <button type="submit" class="btn btn--small btn--danger">Удалить</button>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Items.Any())
            {
                <tr>
                    <td colspan="6" class="task-list__empty">Задач нет</td>
                </tr>
            }
        </tbody>
    </table>

    <!-- Пагинация -->
    @if (Model.TotalPages > 1)
    {
        <nav class="pagination">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <a class="@(i == Model.CurrentPage ? "btn btn--active" : "btn btn--ghost")"
                   asp-page="/Tasks/Index"
                   asp-route-page="@i"
                   asp-route-pageSize="@Model.PageSize"
                   asp-route-categoryId="@Model.CategoryId"
                   asp-route-sortBy="@Model.SortBy"
                   asp-route-search="@Model.Search">
                    @i
                </a>
            }
        </nav>
    }

    <div class="row" style="margin-top:1rem;">
        <a asp-page="/Tasks/Create" class="btn">+ Создать задачу</a>
        <a asp-page="/Categories/Index" class="btn btn--ghost">Управление категориями</a>
    </div>
</section>